# Postgres (Neon/Supabase uchun oxirida ?sslmode=require bo'lsin)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# BotFather bergan token
TELEGRAM_BOT_TOKEN=

# Mini appning HTTPS manzili, oxirida "/" BO'LMASIN
APP_URL=https://sizning-domeningiz.vercel.app

# Admin Telegram ID lari (vergul bilan). ID: @userinfobot
ADMIN_IDS=

# Ixtiyoriy: yangi buyurtma/chek xabarlari boradigan chat ID
ADMIN_CHAT_ID=

# Ixtiyoriy: webhook xavfsizligi uchun
TELEGRAM_WEBHOOK_SECRET=

# Uzun tasodifiy matn (kamida 32 belgi). Yaratish: openssl rand -hex 32
SESSION_SECRET=
